# Dhan is the preferred/default broker. Never commit your completed .env.
BROKER=dhan
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
# Defaults: http://127.0.0.1:8838 and .data/dhan/paper.json
PORT=8838
# Optional overrides (absolute paths recommended):
# PYTHON_BIN=/path/to/repository/.venv/bin/python
# RENKO_DATA=/path/to/private/paper-state
# DHAN_CREDENTIALS_FILE=/path/to/private/dhan-credentials.json
# FYERS_CREDENTIALS_DIR=/path/to/private/fyers-directory
